# Copy to .env.local for `npm run dev`, and set the same names in Vercel → Settings → Environment Variables.
# The app itself works without any of these (everything is stored on the device);
# they are needed only for push notifications and family sync.

# Web Push (generate with: npm run vapid)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=https://your-app.vercel.app

# Protects /api/cron/daily (any long random string; Vercel Cron sends it automatically)
CRON_SECRET=

# Upstash Redis (either pair works; Vercel's KV integration sets the KV_* names)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# Upstash QStash — "next feeding" reminders while the app is closed (optional)
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=
# QSTASH_URL=
# PUBLIC_BASE_URL=https://your-app.vercel.app
